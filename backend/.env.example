# Copy this file to backend/.env and put in your real key.
# backend/.env is gitignored, so the key never ends up on GitHub.

# Google Gemini API key (from Google AI Studio). The server uses it for
# /extract, /explain, /draft and /agent.
GEMINI_API_KEY=

# Which websites can call this server, separated by commas.
# "*" means any website, which is what the live app uses.
ALLOWED_ORIGINS=*
